# Dependencies for the packages managed by this repository.
# Install with: brew bundle
#
# This is intentionally the *required* toolchain, not a dump of everything
# installed on the maintainer's machine.

# Required by install.sh
brew "stow"

# Editors & shells referenced by configs
brew "nvim"
brew "fish"

# Git TUI (gitu/ config)
brew "gitu"

# Terminal emulator (ghostty/ config)
cask "ghostty"

# Discord client (equibop/ config)
cask "equibop"
